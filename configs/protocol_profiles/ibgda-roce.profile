# Mechanism example, not a measured GPU/NIC calibration.
protocolModel = ns3::RoceProtocolModel
StartupDelayNs = 40000
WireEfficiency = 1.0
rdmaSubmission = ibgda
interNodeFabricType = RoCE
interNodeTopology = host
interNodeBandwidthGbps = 200
interNodeLatencyNs = 0
ibgdaProducers = 4
ibgdaQpsPerPeer = 2
ibgdaQueueDepth = 128
ibgdaDoorbellBatch = 4
ibgdaBatchTimeoutNs = 100
ibgdaCqModeration = 16
ibgdaMtu = 4096
ibgdaWqeBytes = 64
# Illustrative stage times, supplied independently of bandwidth measurements.
ibgdaWqeBuildNs = 100
ibgdaPublishNs = 20
ibgdaDoorbellNs = 100
ibgdaWqeFetchNs = 100
ibgdaDmaReadNs = 50
ibgdaDmaWriteNs = 50
ibgdaCqWriteNs = 50
ibgdaGpuPollNs = 50
ibgdaPcieReadGbps = 256
ibgdaPcieWriteGbps = 256
ibgdaHbmReadGbps = 8000
ibgdaHbmWriteGbps = 8000
fecN = 544
fecK = 514
fecT = 15
fecEnabled = 0
llrEnabled = 0
berIntraNodeElectrical = 0
berIntraRackElectrical = 0
berInterRackOptical = 0
